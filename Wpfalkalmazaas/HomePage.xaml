<Page x:Class="Wpfnavigation.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpfnavigation"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#F8FAFC"
      Title="HomePage">

    <Grid Margin="40">
        <StackPanel>
            <TextBlock Text="Főoldal" FontSize="32" FontWeight="bold"
                       Foreground="#1E293B"/>
            <TextBlock Text="Ez a tartalom egy Page-ben található" 
                       FontSize="16" Foreground="#647488" Margin="0,10,0,25"/>
            <Border Background="White" CornerRadius="15" Padding="25">
                <StackPanel>
                    <TextBlock Text="Page navigáció"
                               FontSize="20"
                               FontWeight="Bold"/>
                    <TextBlock Text="A Page nem uj ablakot nyit" TextWrapping="Wrap"
                               Margin="0,10,0,20"/>
                    <Button Content="Tovább a profil oldalra"
                            Height="45" Click="GoToProfile_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
        
        
    </Grid>
</Page>
